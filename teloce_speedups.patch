+    except _FastLexFallback:
+        depth = 0
+        for token in LegacyJavaScriptLexer(source[opening:]).tokenize():
+            if token.value == open_char:
+                depth += 1
+            elif token.value == close_char:
+                depth -= 1
+                if depth == 0:
+                    return opening + token.end
+        return None
