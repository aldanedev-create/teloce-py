<template>
  <main class="story-app">
    <header class="hero">
      <p class="eyebrow">Teloce-Py data story</p>
      <h1>Small data, clear decisions.</h1>
      <p class="lede">A production-shaped example using Python APIs and reactive .vel UI.</p>
      <div class="metrics">
        <MetricCard title="Rows loaded" :value="rows.length" data-metric="rows" />
        <MetricCard title="Visible step" :value="activeStep === 'detail' ? 2 : 1" hint="URL-synced story state" />
        <MetricCard title="API requests" :value="stats.requests" class="accent-card" />
      </div>
    </header>

    <section class="story" v-scrolly @step="activeStep = $event.detail.name">
      <article class="story-step" v-step="overview" tabindex="0">
        <span class="step-number">01</span>
        <h2>Start with the shape of the evidence.</h2>
        <p>CSV is parsed in the browser with numeric and date coercion. The Python server only provides the page and API.</p>
      </article>
      <article class="story-step" v-step="detail" tabindex="0">
        <span class="step-number">02</span>
        <h2>Then show the details without flooding the DOM.</h2>
        <p>Scroll the list: <code>v-virtual-for</code> renders only the visible rows and preserves stable keys.</p>
      </article>
    </section>

    <section class="dashboard">
      <div class="panel chart-panel" use:focusPanel="{ label: 'evidence chart' }" v-chart-annotation="{ text: annotation, target: 'peak', x: 58 }">
        <div class="chart-bars" aria-label="Values by story row">
          <span v-for="row in rows" :key="row.id" v-memo="row.id + ':' + activeStep" :style="{ height: (row.value / 14) + 'px' }" :title="row.title"></span>
        </div>
        <p class="annotation-copy">{{ annotation }}</p>
      </div>
      <div class="panel">
        <div class="panel-heading"><h2>All rows</h2><span>{{ rows.length }} records</span></div>
        <div class="virtual-list" v-virtual-for="row in rows" :key="row.id" item-height="42" overscan="3">
          <div class="virtual-row"><b>{{ row.title }}</b><span>{{ row.category }} &middot; {{ row.value | number }}</span></div>
        </div>
      </div>
    </section>

    <section class="panel table-panel">
      <div class="panel-heading"><h2>Sortable, filterable table</h2><span>Try a category or title</span></div>
      <div v-data-table="{ rows: rows, columns: tableColumns, pageSize: 5 }"></div>
    </section>

    <div class="poll-sentinel" poll="/api/stats" interval="15000" poll-target="stats" aria-hidden="true"></div>
  </main>
</template>

<script>
import MetricCard from "./components/MetricCard.vel";
import { loadCsv } from "../teloce-runtime.js";

function focusPanel(node, params) {
  node.dataset.actionLabel = params?.label || "panel";
  return {
    update(next) { node.dataset.actionLabel = next?.label || "panel"; },
    destroy() { delete node.dataset.actionLabel; }
  };
}

export default {
  data() {
    return {
      rows: [],
      activeStep: "overview",
      annotation: "The highest value is highlighted after the CSV is loaded.",
      stats: { requests: 0 },
      tableColumns: [
        { key: "title", label: "Story" },
        { key: "category", label: "Category" },
        { key: "value", label: "Value" },
        { key: "reported", label: "Reported" }
      ]
    };
  },
  queryState: { activeStep: { type: "string", key: "step" } },
  async mounted() {
    this.rows = await loadCsv("/static/data/report.csv", { types: { id: "number", value: "number", reported: "date" } });
  }
};
</script>

<style scoped>
:global(*) { box-sizing: border-box; }
:global(body) { margin: 0; background: #eef4f8; color: #182536; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
.story-app { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 5rem; }
.hero { padding: 2.5rem; border-radius: 1.5rem; color: white; background: linear-gradient(135deg, #153b5b, #267d8f); box-shadow: 0 1rem 3rem #1832472b; }
.eyebrow, .step-number { color: #8ce4d7; font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
h1 { max-width: 650px; margin: .5rem 0; font-size: clamp(2.4rem, 6vw, 5rem); line-height: .98; }
.lede { max-width: 580px; color: #d8f2f1; font-size: 1.08rem; }
.metrics, .dashboard { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
.accent-card { border-color: #8ce4d7; }
.story { display: grid; gap: 1rem; margin: 2rem 0; }
.story-step { min-height: 190px; padding: 2rem; border-left: 4px solid #65cfc3; border-radius: 1rem; background: white; box-shadow: 0 .5rem 2rem #18324712; }
.story-step h2 { margin: .5rem 0; font-size: clamp(1.5rem, 3vw, 2.25rem); }
.dashboard { grid-template-columns: 1fr 1fr; }
.panel { min-width: 0; padding: 1.25rem; border: 1px solid #d7e2ee; border-radius: 1rem; background: white; box-shadow: 0 .5rem 2rem #18324712; }
.panel-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
.panel-heading h2 { margin: 0; font-size: 1.15rem; }
.panel-heading span, .virtual-row span { color: #6e7f91; font-size: .85rem; }
.chart-bars { display: flex; align-items: end; gap: .35rem; min-height: 150px; padding: 1rem 0; border-bottom: 1px solid #d7e2ee; }
.chart-bars span { flex: 1; min-width: 7px; border-radius: .4rem .4rem 0 0; background: linear-gradient(#65cfc3, #287d93); transition: opacity .2s, transform .2s; }
.chart-bars span:hover { opacity: .7; transform: translateY(-4px); }
.annotation-copy { margin-bottom: 0; color: #5b6b7d; }
.virtual-list { height: 190px; overflow-y: auto; margin-top: 1rem; padding: .5rem; border: 1px solid #d7e2ee; border-radius: .7rem; }
.virtual-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; height: 42px; border-bottom: 1px solid #eef4f8; }
.table-panel { margin-top: 1rem; }
.teloce-chart-annotation { padding: .35rem .6rem; border-radius: .5rem; color: white; background: #153b5b; font-size: .8rem; }
.poll-sentinel { display: none; }
@media (max-width: 760px) { .story-app { width: min(100% - 1rem, 620px); padding-top: 1rem; } .hero { padding: 1.5rem; } .metrics, .dashboard { grid-template-columns: 1fr; } }
</style>
